# Сам .env никогда не должен попадать в git — он уже в .gitignore.

# Токен бота, полученный от @BotFather в Telegram.
BOT_TOKEN='7773168388:AAEyNCmsXsTNEy_ncW50TNDRd_zdIN1n5Ng'

# Секретный ключ для подписи сессионных cookie админки (/manage и /admin).
# Если оставить пустым — сгенерируется автоматически и сохранится в файл
# .secret_key при первом запуске (удобно для локальной разработки).
# Для продакшена (особенно в Docker) лучше задать явно — сгенерировать
# случайную строку можно командой:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
