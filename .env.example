# Скопируй этот файл в .env и впиши свои настоящие значения.
# Сам .env никогда не должен попадать в git — он уже в .gitignore.

# Токен бота, полученный от @BotFather в Telegram.
BOT_TOKEN='твой_токен_от_botfather'

# Секретный ключ для подписи сессионных cookie админки (/manage и /admin).
# Если оставить пустым — сгенерируется автоматически и сохранится в файл
# .secret_key при первом запуске (удобно для локальной разработки без
# Docker). Для Docker (особенно в продакшене) лучше задать явно —
# сгенерировать случайную строку можно командой:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Только для запуска без Docker (адрес базы задаётся напрямую) ---
# По умолчанию не нужен — без Docker используется локальный SQLite-файл.
# DATABASE_URL=sqlite:///./english_bot.db

# --- Только для Docker (и docker-compose.yml, и docker-compose.prod.yml) ---
# DATABASE_URL для контейнеров собирается автоматически из этих трёх
# переменных (см. docker-compose.yml) — просто задай логин/пароль/имя БД.
# Для локальной разработки можно оставить значения по умолчанию.
# Для продакшена (docker-compose.prod.yml) ОБЯЗАТЕЛЬНО задай свой пароль —
# там нет значения "по умолчанию", запуск не начнётся без него.
POSTGRES_USER=english_bot
POSTGRES_PASSWORD=english_bot
POSTGRES_DB=english_bot
